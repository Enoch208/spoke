{
  "name": "@spoke/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "deploy:local": "forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast --slow --non-interactive",
    "fixture:keys": "node scripts/create-fixture-keys.ts",
    "abi": "forge build && node scripts/export-abi.ts && prettier --write ../protocol/src/abi --ignore-path ''",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#f3dae6e6ee381f25eb6a246f7da9b85c91a68219"
  }
}
